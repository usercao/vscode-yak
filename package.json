{
  "name": "next-yak-vscode",
  "displayName": "next-yak",
  "version": "0.1.0",
  "description": "CSS syntax highlighting and completion for next-yak tagged templates.",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "css-in-js",
    "next-yak",
    "syntax-highlighting"
  ],
  "license": "MIT",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/usercao/next-yak-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/usercao/next-yak-vscode/issues"
  },
  "homepage": "https://github.com/usercao/next-yak-vscode#readme",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:integration:build": "tsdown --config tsdown.tests.config.ts",
    "test:integration": "yarn build && yarn test:integration:build && node ./.vscode-test/compiled/runExtensionTests.cjs",
    "verify": "yarn check && yarn test && yarn test:integration && yarn package",
    "vscode:prepublish": "yarn build",
    "package": "yarn vsce package --no-yarn --no-dependencies --out ./next-yak-vscode-${npm_package_version}.vsix"
  },
  "dependencies": {
    "color-name": "^2.1.1",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/color-name": "^2.0.0",
    "@types/node": "^24",
    "@types/vscode": "^1.134.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "3.9.2",
    "tsdown": "^0.22.14",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "contributes": {
    "configuration": {
      "title": "next-yak",
      "properties": {
        "nextYak.css.validate": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Enable CSS diagnostics inside statically recognized next-yak tagged templates. This does not affect CSS completion or hover."
        }
      }
    },
    "grammars": [
      {
        "scopeName": "next-yak.injection",
        "path": "./syntaxes/next-yak.injection.json",
        "injectTo": [
          "source.ts",
          "source.tsx"
        ],
        "embeddedLanguages": {
          "meta.embedded.line.ts": "typescript",
          "meta.embedded.line.tsx": "typescriptreact",
          "source.css": "css"
        }
      },
      {
        "scopeName": "next-yak-js.injection",
        "path": "./syntaxes/next-yak-js.injection.json",
        "injectTo": [
          "source.js",
          "source.js.jsx"
        ],
        "embeddedLanguages": {
          "meta.embedded.line.js": "javascript",
          "source.css": "css"
        }
      }
    ]
  },
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact"
  ],
  "engines": {
    "vscode": "^1.134.0",
    "node": ">=24.19.0"
  },
  "packageManager": "yarn@4.18.0"
}
