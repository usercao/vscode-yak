{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "next-yak-js.injection",
  "injectionSelector": "L:source.js, L:source.js.jsx",
  "patterns": [
    {
      "name": "meta.embedded.block.css.next-yak",
      "contentName": "source.css",
      "begin": "\\b(styled)(?:\\s*\\.\\s*[_$[:alpha:]][_$[:alnum:]]*|\\s*\\([^()`]*\\))\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.tagged-template.next-yak"
        },
        "2": {
          "name": "punctuation.definition.string.template.begin.next-yak"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.end.next-yak"
        }
      },
      "patterns": [
        {
          "include": "#interpolation-js"
        },
        {
          "include": "#root-selector"
        },
        {
          "include": "#root-incomplete-selector"
        },
        {
          "include": "#root-declaration"
        },
        {
          "include": "source.css"
        }
      ]
    },
    {
      "name": "meta.embedded.block.css.next-yak",
      "contentName": "source.css",
      "begin": "\\b(css|globalStyle|keyframes)\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.tagged-template.next-yak"
        },
        "2": {
          "name": "punctuation.definition.string.template.begin.next-yak"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.end.next-yak"
        }
      },
      "patterns": [
        {
          "include": "#interpolation-js"
        },
        {
          "include": "#root-selector"
        },
        {
          "include": "#root-incomplete-selector"
        },
        {
          "include": "#root-declaration"
        },
        {
          "include": "source.css"
        }
      ]
    }
  ],
  "repository": {
    "root-selector": {
      "begin": "(?m)^(?=\\s*(?:[^{}\\n]*)(?:::[-_a-zA-Z][-_a-zA-Z0-9]*|:[-_a-zA-Z][-_a-zA-Z0-9]*)(?:[^{}\\n]*)\\{)",
      "end": "(?=\\{)",
      "name": "meta.selector.css",
      "patterns": [
        {
          "include": "source.css#selector-innards"
        }
      ]
    },
    "root-incomplete-selector": {
      "begin": "(?m)^(\\s*)(?=[a-zA-Z][-_a-zA-Z0-9]*(?::(?:active|any-link|checked|disabled|empty|enabled|first|(?:first|last|only)-(?:child|of-type)|focus|focus-visible|focus-within|fullscreen|host|hover|in-range|indeterminate|invalid|left|link|optional|out-of-range|read-only|read-write|required|right|root|scope|target|unresolved|valid|visited)(?![-_a-zA-Z0-9])|::?(?:after|before|first-letter|first-line|backdrop|content|grammar-error|marker|placeholder|selection|shadow|spelling-error)(?![-_a-zA-Z0-9])|:(?:dir|lang|not|has|matches|where|is|nth-(?:last-)?(?:child|of-type))\\()[^{};\\n]*$)",
      "end": "$",
      "name": "meta.selector.css",
      "patterns": [
        {
          "include": "source.css#selector-innards"
        }
      ]
    },
    "interpolation-js": {
      "name": "meta.embedded.line.js",
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.next-yak"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.next-yak"
        }
      },
      "patterns": [
        {
          "include": "source.js#expression"
        }
      ]
    },
    "root-declaration": {
      "patterns": [
        {
          "name": "meta.property-list.next-yak",
          "contentName": "meta.property-value.css",
          "begin": "(?m)^(\\s*)(--[-_a-zA-Z][-_a-zA-Z0-9]*)(\\s*:\\s*)",
          "beginCaptures": {
            "2": {
              "name": "variable.css"
            },
            "3": {
              "name": "punctuation.separator.key-value.css"
            }
          },
          "end": "(;)|(?=\\n|`|\\})",
          "endCaptures": {
            "1": {
              "name": "punctuation.terminator.rule.css"
            }
          },
          "patterns": [
            {
              "include": "#interpolation-js"
            },
            {
              "include": "source.css#property-values"
            }
          ]
        },
        {
          "name": "meta.property-list.next-yak",
          "contentName": "meta.property-value.css",
          "begin": "(?m)^(\\s*)([a-zA-Z-]+)(\\s*:\\s*)",
          "beginCaptures": {
            "2": {
              "name": "meta.property-name.css support.type.property-name.css"
            },
            "3": {
              "name": "punctuation.separator.key-value.css"
            }
          },
          "end": "(;)|(?=\\n|`|\\})",
          "endCaptures": {
            "1": {
              "name": "punctuation.terminator.rule.css"
            }
          },
          "patterns": [
            {
              "include": "#interpolation-js"
            },
            {
              "include": "source.css#property-values"
            }
          ]
        }
      ]
    }
  }
}
