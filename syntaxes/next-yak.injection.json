{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "next-yak.injection",
  "injectionSelector": "L:source.ts, L:source.tsx",
  "patterns": [
    {
      "name": "meta.embedded.block.css.next-yak",
      "contentName": "source.css",
      "begin": "\\b(styled)(?:\\s*\\.\\s*[_$[:alpha:]][_$[:alnum:]]*|\\s*\\([^()`]*\\))\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.tagged-template.next-yak"
        },
        "2": {
          "name": "punctuation.definition.string.template.begin.next-yak"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.end.next-yak"
        }
      },
      "patterns": [
        {
          "include": "#interpolation-ts"
        },
        {
          "include": "#root-declaration"
        },
        {
          "include": "source.css"
        }
      ]
    },
    {
      "name": "meta.embedded.block.css.next-yak",
      "contentName": "source.css",
      "begin": "\\b(css|globalStyle|keyframes)\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.tagged-template.next-yak"
        },
        "2": {
          "name": "punctuation.definition.string.template.begin.next-yak"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.end.next-yak"
        }
      },
      "patterns": [
        {
          "include": "#interpolation-ts"
        },
        {
          "include": "#root-declaration"
        },
        {
          "include": "source.css"
        }
      ]
    }
  ],
  "repository": {
    "interpolation-ts": {
      "name": "meta.embedded.line.ts",
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.next-yak"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.next-yak"
        }
      },
      "patterns": [
        {
          "include": "source.ts#expression"
        }
      ]
    },
    "root-declaration": {
      "patterns": [
        {
          "name": "meta.property-list.next-yak",
          "contentName": "meta.property-value.css",
          "begin": "(?m)^(\\s*)(--[-_a-zA-Z][-_a-zA-Z0-9]*)(\\s*:\\s*)",
          "beginCaptures": {
            "2": {
              "name": "variable.css"
            },
            "3": {
              "name": "punctuation.separator.key-value.css"
            }
          },
          "end": "(;)|(?=\\n|`|\\})",
          "endCaptures": {
            "1": {
              "name": "punctuation.terminator.rule.css"
            }
          },
          "patterns": [
            {
              "include": "#interpolation-ts"
            },
            {
              "include": "source.css#property-values"
            }
          ]
        },
        {
          "name": "meta.property-list.next-yak",
          "contentName": "meta.property-value.css",
          "begin": "(?m)^(\\s*)([a-zA-Z-]+)(\\s*:\\s*)",
          "beginCaptures": {
            "2": {
              "name": "meta.property-name.css support.type.property-name.css"
            },
            "3": {
              "name": "punctuation.separator.key-value.css"
            }
          },
          "end": "(;)|(?=\\n|`|\\})",
          "endCaptures": {
            "1": {
              "name": "punctuation.terminator.rule.css"
            }
          },
          "patterns": [
            {
              "include": "#interpolation-ts"
            },
            {
              "include": "source.css#property-values"
            }
          ]
        }
      ]
    }
  }
}
