{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "tsdown.config.ts",
    "tsdown.tests.config.ts"
  ]
}
