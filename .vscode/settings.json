{
  // Use the project-local Oxfmt through the official Oxc extension
  "prettier.enable": false,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.detectIndentation": false,
  "editor.formatOnSave": false,
  "editor.formatOnSaveMode": "file",
  "editor.insertSpaces": true,
  "editor.rulers": [100],
  "editor.tabSize": 2,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  // Apply safe Oxlint fixes after formatting
  "editor.codeActionsOnSave": {
    "source.format.oxc": "always",
    "source.fixAll.oxc": "always",
    "source.organizeImports": "never"
  },

  // Use the workspace TypeScript SDK so tsserver plugins from package.json are loaded
  "js/ts.tsdk.path": "node_modules/typescript/lib",

  // Markdown uses trailing spaces for explicit line breaks
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "oxc.disableNestedConfig": true,
  "oxc.fmt.disableNestedConfig": true,

  // 关闭 Copilot 所有语言的内联补全
  "github.copilot.enable": {
    "*": false
  },

  // 禁止 Copilot 自动触发补全
  "github.copilot.editor.enableAutoCompletions": false,

  // 关闭 Copilot 的“下一处编辑建议”
  "github.copilot.nextEditSuggestions.enabled": false
}
