{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Yak extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/test-workspace"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.mjs"],
      "preLaunchTask": "yarn: build"
    }
  ]
}
